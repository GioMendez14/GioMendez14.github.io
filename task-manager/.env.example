# Cadena de conexión de PostgreSQL (Neon: copia la "pooled connection string")
DATABASE_URL="postgresql://usuario:password@host:5432/taskmanager?sslmode=require"

# Secreto para firmar la sesión. Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-valor-largo-y-aleatorio"

# URL pública de la app (en Vercel: https://tu-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
